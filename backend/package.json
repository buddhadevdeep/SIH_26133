{
  "name": "healthconnect-backend",
  "version": "1.0.0",
  "description": "Production Node.js + Express + TypeScript + MongoDB Backend for HealthConnect",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:reset": "ts-node src/scripts/resetDb.ts",
    "db:bootstrap": "ts-node src/scripts/bootstrapDb.ts",
    "db:check-integrity": "ts-node src/scripts/checkIntegrity.ts",
    "test:workflow": "npm run db:reset && npm run db:bootstrap && ts-node test_real_workflow.ts",
    "test:multidistrict": "npm run db:reset && npm run db:bootstrap && ts-node test_multidistrict_isolation.ts",
    "test:api": "ts-node src/tests/integrationTest.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
